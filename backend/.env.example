# Copy these into Railway environment variables
APP_ENV=production
APP_PORT=8080

# From Neon dashboard
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_random_64_char_string
JWT_REFRESH_SECRET=replace_with_different_random_64_char_string
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Your Vercel frontend URL (set after deploying frontend)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
LOG_LEVEL=info
